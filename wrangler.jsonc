{
  // Cloudflare Workers config: serve the built Astro site as static files,
  // and forward /bourboncompare/ to its Vercel deployment (worker/index.js).
  "name": "rawkrabbit-com",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served straight from dist/.
    "run_worker_first": ["/bourboncompare", "/bourboncompare/*"]
  },
  "vars": {
    // The Vercel project that builds bourbon-compare/ (Root Directory setting).
    "BOURBON_ORIGIN": "https://bourbon-comparison.vercel.app"
  },
  // Required for per-branch and PR preview deploys (npx wrangler preview).
  "previews": {}
}

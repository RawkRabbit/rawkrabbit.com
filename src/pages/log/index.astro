---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('log', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const projects = await getCollection('projects');
const nameOf = (id?: string) => projects.find((p) => p.id === id)?.data.name;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Log" description="Releases, changes and notes from the RawkRabbit workshop.">
  <section class="wrap head">
    <p class="eyebrow">Log</p>
    <h1>Workshop log</h1>
    <p class="lede muted">Releases, changes and notes. Also available as <a href="/rss.xml">RSS</a>.</p>
  </section>
  <section class="wrap">
    <ol class="entries">
      {entries.map((e) => (
        <li>
          <time class="mono muted" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          <div>
            <a class="title" href={`/log/${e.id}/`}>{e.data.title}</a>
            {e.data.project && nameOf(e.data.project) && <span class="mono muted proj">{nameOf(e.data.project)}</span>}
            <p class="muted">{e.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .head { padding-top: clamp(3rem, 8vw, 5rem); padding-bottom: 2.5rem; }
  .lede { font-size: 1.2rem; margin: 1rem 0 0; }
  .entries { list-style: none; margin: 0; padding: 0; }
  .entries li { display: grid; grid-template-columns: 8rem 1fr; gap: 1.5rem; padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .title { font-weight: 600; font-size: 1.1rem; color: var(--fg); margin-right: 0.75rem; }
  .entries p { margin: 0.3rem 0 0; }
  @media (max-width: 640px) { .entries li { grid-template-columns: 1fr; gap: 0.3rem; } }
</style>

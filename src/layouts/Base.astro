---
import '../styles/global.css';
import Lockup from '../components/Lockup.astro';
import Mark from '../components/Mark.astro';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'A workshop for small, useful things. Random projects, built because they should exist, shipped without the ad junk.',
  image = '/rawkrabbit-avatar-1024.png',
} = Astro.props;
const fullTitle = title ? `${title} · RawkRabbit` : 'RawkRabbit · A workshop for small, useful things';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/log/', label: 'Log' },
  { href: '/about/', label: 'About' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/rawkrabbit-avatar-1024.png" />
    <link rel="alternate" type="application/rss+xml" title="RawkRabbit log" href="/rss.xml" />
    <meta name="theme-color" content="#16181D" />
    <meta property="og:site_name" content="RawkRabbit" />
    <meta property="og:title" content={title ?? 'RawkRabbit'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="home" aria-label="RawkRabbit home"><Lockup size={28} /></a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="sig">
          <Mark size={22} />
          <p><span class="wordmark"><b>Rawk</b><span>Rabbit</span></span> <span class="mono muted">say it: rock rabbit</span></p>
        </div>
        <ul class="mono">
          <li><a href="mailto:hello@rawkrabbit.com">hello@rawkrabbit.com</a></li>
          <li><a href="https://github.com/RawkRabbit">github.com/RawkRabbit</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
        <p class="mono muted small">© {year} RawkRabbit. No ads, no trackers.</p>
      </div>
    </footer>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 0.5rem; background: var(--fg); color: var(--bg); padding: 0.5rem 0.75rem; border-radius: 6px; z-index: 10; }
  .skip:focus { left: 0.5rem; }
  .site-header { border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.25rem; }
  .home { text-decoration: none; color: var(--fg); }
  nav { display: flex; gap: clamp(0.9rem, 3vw, 1.75rem); }
  nav a { color: var(--fg); text-decoration: none; font-weight: 500; font-size: 0.95rem; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--line); }
  nav a[aria-current='page'] { border-bottom-color: var(--amp); }
  .site-footer { border-top: 1px solid var(--line); margin-top: clamp(3rem, 8vw, 6rem); padding: 2.5rem 0 3rem; }
  .foot { display: grid; gap: 1.25rem; grid-template-columns: 1fr auto; align-items: start; }
  .sig { display: flex; align-items: center; gap: 0.6rem; }
  .sig p { margin: 0; display: flex; gap: 0.75rem; align-items: baseline; flex-wrap: wrap; }
  .sig .wordmark { font-size: 1.05rem; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .foot ul a { color: var(--fg); }
  .small { grid-column: 1 / -1; margin: 0; font-size: 0.75rem; }
  @media (max-width: 640px) {
    .foot { grid-template-columns: 1fr; }
    .home :global(.wordmark) { font-size: 1.15rem; }
  }
  @media (max-width: 380px) { nav { gap: 0.75rem; } nav a { font-size: 0.875rem; } }
</style>

---
import { formatRating, starFills, NOT_RATED } from '../lib/ag.ts';

interface Props { rating: number | null; size?: 'sm' | 'lg' }
const { rating, size = 'lg' } = Astro.props;
const label = formatRating(rating);
const STAR = 'M12 2.5l2.94 6.06 6.66.92-4.85 4.66 1.18 6.62L12 17.6l-5.93 3.16 1.18-6.62L2.4 9.48l6.66-.92z';
---
{rating === null ? (
  <span class={`stars-none ${size}`}>{NOT_RATED}</span>
) : (
  <span class={`stars ${size}`} role="img" aria-label={`${label} stars`}>
    {starFills(rating).map((f) => (
      <span class="star" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="empty"><path d={STAR} /></svg>
        {f > 0 && (
          <span class="fill" style={`width:${f * 100}%`}>
            <svg viewBox="0 0 24 24"><path d={STAR} /></svg>
          </span>
        )}
      </span>
    ))}
    <span class="stars-num" aria-hidden="true">{label}</span>
  </span>
)}

<style>
  .stars { display: inline-flex; align-items: center; gap: 2px; white-space: nowrap; }
  .star { position: relative; display: inline-block; width: 1.25em; height: 1.25em; }
  .star svg { width: 1.25em; height: 1.25em; display: block; }
  .star .empty path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .star .fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; }
  .star .fill path { fill: var(--accent); stroke: var(--accent); stroke-width: 1.5; }
  .stars-num { margin-left: 8px; font-family: var(--font-mono); color: var(--text-secondary); font-size: 0.9em; }
  .lg { font-size: 1.25rem; }
  .sm { font-size: 0.8rem; }
  .stars-none { color: var(--text-muted); font-size: 0.9rem; }
  .stars-none.sm { font-size: 0.78rem; }
</style>
